# Copy this file to .env and fill in your real keys.
# You only need the key for the provider you plan to run.

# Gemini (default profile) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# OpenRouter (openrouter profile) — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here
