<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.triager</groupId>
    <artifactId>provider-portability</artifactId>
    <version>1.0.0</version>
    <name>provider-portability</name>
    <description>Recipe 04 — Running the same Spring AI code against Gemini and OpenRouter</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.6</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <!--
        The provider lives in a Maven profile, not the main dependencies block.
        Only one chat-model starter is ever on the classpath at a time, which
        avoids the ambiguous-ChatModel-bean problem you hit if you put two
        native starters side by side.

        Switch provider at build/run time with the -P flag:
          ./mvnw spring-boot:run                      (gemini, the default)
          ./mvnw spring-boot:run -Popenrouter         (openrouter)

        Note that the OpenRouter profile uses the SAME OpenAI starter that any
        OpenAI-compatible endpoint uses. OpenRouter speaks the OpenAI protocol,
        so Spring AI talks to it through spring-ai-starter-model-openai.
    -->
    <profiles>
        <profile>
            <id>gemini</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-google-genai</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>openrouter</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
