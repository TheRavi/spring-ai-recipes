<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.triager</groupId>
    <artifactId>rag-basics</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-basics</name>
    <description>Recipe 05 — Retrieval-augmented generation with Spring AI, Gemini, and an in-memory vector store</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.6</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            The chat starter. This is the one every previous recipe used.
            It gives you a ChatModel. It does NOT give you an EmbeddingModel.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <!--
            The embedding starter. THIS is the one RAG needs and the one that
            trips people up. The chat starter does not auto-configure an
            EmbeddingModel, so without this dependency the SimpleVectorStore
            bean fails to construct with a missing-EmbeddingModel error.
            RAG is the first recipe in this series that needs two starters.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai-embedding</artifactId>
        </dependency>

        <!--
            The vector store API itself. This artifact provides the VectorStore
            interface and the in-memory SimpleVectorStore implementation. The
            chat and embedding starters do NOT pull this in transitively, so
            without it you get "import org.springframework.ai.vectorstore cannot
            be resolved" at compile time.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!--
            The vector-store advisors. This artifact provides QuestionAnswerAdvisor
            (the one-call RAG advisor) and VectorStoreChatMemoryAdvisor. Also not
            transitive, so without it you get "import
            org.springframework.ai.chat.client.advisor.vectorstore cannot be
            resolved" at compile time.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
